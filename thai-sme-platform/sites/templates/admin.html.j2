<!doctype html>
<html lang="en" data-ui="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bookings · {{ site.name.en }}</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/static/site.css">
<style>:root { --primary: {{ site.theme.primary }}; --accent: {{ site.theme.accent }}; --surface: #fff; --ink: #111; }</style>
</head>
<body>
<main class="block">
  <h1>Bookings — {{ site.name.en }}</h1>
  {% if not bookings %}<p>No bookings yet.</p>{% else %}
  <div class="table-wrap">
  <table class="admin">
    <thead><tr><th>Ref</th><th>Status</th><th>Summary</th><th>Name</th><th>Contact</th><th>Total</th><th>Deposit</th><th>Note</th></tr></thead>
    <tbody>
    {% for bk in bookings %}
      <tr><td>{{ bk.ref }}</td><td>{{ bk.status }}</td><td>{{ bk.summary }}</td><td>{{ bk.name }}</td><td>{{ bk.contact }}</td>
          <td>{{ bk.total|baht if bk.total else '—' }}</td><td>{{ bk.deposit|baht if bk.deposit else '—' }}</td><td>{{ bk.note }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

  {% if calendar %}
  <h2>Room prices — next 30 nights</h2>
  <p>Pricing mode: <strong>{{ pricing_mode }}</strong>
    {% if pricing_mode == 'auto' %}(the website charges the suggested price){% else %}(the website charges the base rate; suggestions are shown here for you to accept){% endif %}.
    Hover a price to see why.</p>
  {% for room in calendar %}
  <h3>{{ room.name.en }} — base {{ room.base|baht }}</h3>
  <div class="table-wrap">
  <table class="admin rates">
    <thead><tr><th>Night</th>{% for n in room.nights %}<th>{{ n.date[5:] }}</th>{% endfor %}</tr></thead>
    <tbody>
      <tr><th>Booked</th>{% for n in room.nights %}<td>{{ n.booked }}/{{ n.units }}</td>{% endfor %}</tr>
      <tr><th>Price</th>{% for n in room.nights %}<td title="{% for a in n.adjustments %}{{ a[0] }} {{ '%+d'|format(a[1]) }}%; {% endfor %}{% if n.clamped %}limited by floor/ceiling{% endif %}"
        class="{{ 'up' if n.price > n.base else ('down' if n.price < n.base else '') }}">{{ n.price|baht }}</td>{% endfor %}</tr>
    </tbody>
  </table>
  </div>
  {% endfor %}
  {% endif %}
</main>
</body>
</html>
