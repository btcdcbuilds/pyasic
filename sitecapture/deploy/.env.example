# Copy to .env and fill in. Never commit .env.

# Domain pointing at this VPS (an A record). Caddy gets the HTTPS certificate.
SITECAPTURE_DOMAIN=capture.example.com

# Database password (any long random string).
POSTGRES_PASSWORD=change-me

# First admin login, created on first start only. Change the password after
# logging in; later changes here have no effect.
SITECAPTURE_ADMIN_EMAIL=you@example.com
SITECAPTURE_ADMIN_PASSWORD=change-me-at-least-10-chars

# AI progress reports.
ANTHROPIC_API_KEY=

# GPU rental: local (no rental, interpolation only), vastai or lambda.
SITECAPTURE_GPU_PROVIDER=local
SITECAPTURE_MAX_GPU_USD_PER_HOUR=1.50
SITECAPTURE_WORKER_IMAGE=
VASTAI_API_KEY=
VASTAI_GPU_NAME=RTX_4090
LAMBDA_API_KEY=
LAMBDA_INSTANCE_TYPE=gpu_1x_a10
LAMBDA_REGION=us-east-1
LAMBDA_SSH_KEY_NAME=

# Largest single upload in GB.
SITECAPTURE_MAX_UPLOAD_GB=20
